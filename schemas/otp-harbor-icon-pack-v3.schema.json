{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otp-harbor.example/schemas/otp-harbor-icon-pack-v3.schema.json",
  "title": "OTP Harbor Icon Pack v3",
  "description": "Theme-resolved, provider-independent, content-addressed PNG appearances stored in an .otphicons container.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "packId", "name", "sources", "brands", "issuerAliases"],
  "properties": {
    "formatVersion": { "const": 3 },
    "packId": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packSource" } },
    "brands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/brand" } },
    "issuerAliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "brandId"],
        "properties": { "key": { "type": "string", "minLength": 1 }, "brandId": { "$ref": "#/$defs/id" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
    "metadata": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
    "packSource": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "inputFileName", "sha256", "version", "revision", "sourceUrl", "metadata", "licenseFiles"],
      "properties": {
        "provider": { "$ref": "#/$defs/id" }, "inputFileName": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }, "version": { "type": ["string", "null"] },
        "revision": { "type": ["string", "null"] }, "sourceUrl": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/metadata" },
        "licenseFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^licenses/" } }
      }
    },
    "sourceReference": {
      "type": "object", "additionalProperties": false, "required": ["provider", "sourceId", "metadata"],
      "properties": { "provider": { "$ref": "#/$defs/id" }, "sourceId": { "type": "string", "minLength": 1 }, "metadata": { "$ref": "#/$defs/metadata" } }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "mediaType", "width", "height", "sha256", "renderProfile"],
      "properties": {
        "path": { "type": "string", "pattern": "^runtime/appearance-128/[a-f0-9]{64}\\.png$" },
        "mediaType": { "const": "image/png" }, "width": { "const": 128 }, "height": { "const": 128 },
        "sha256": { "$ref": "#/$defs/sha256" }, "renderProfile": { "const": "otp-harbor-themed-appearance-v1" }
      }
    },
    "appearanceSource": {
      "type": "object", "additionalProperties": false, "required": ["provider", "sourceId", "assetPath"],
      "properties": { "provider": { "$ref": "#/$defs/id" }, "sourceId": { "type": "string", "minLength": 1 }, "assetPath": { "type": "string", "minLength": 1 } }
    },
    "solidBackground": {
      "type": "object", "additionalProperties": false, "required": ["mode", "color"],
      "properties": { "mode": { "const": "solid" }, "color": { "$ref": "#/$defs/color" } }
    },
    "embeddedBackground": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": { "mode": { "const": "embedded" } }
    },
    "appearance": {
      "oneOf": [
        { "$ref": "#/$defs/foregroundAppearance" },
        { "$ref": "#/$defs/completeAppearance" }
      ]
    },
    "foregroundAppearance": {
      "type": "object", "additionalProperties": false,
      "required": ["asset", "assetRole", "background", "selection", "source", "appearanceSelectionReason"],
      "properties": {
        "asset": { "$ref": "#/$defs/asset" }, "assetRole": { "const": "foreground" },
        "background": { "$ref": "#/$defs/solidBackground" }, "selection": { "enum": ["native-theme-variant", "brand-color-foreground", "complete-source-artwork", "source-default", "reviewed-badge-composition"] },
        "source": { "$ref": "#/$defs/appearanceSource" }, "appearanceSelectionReason": { "type": "string", "minLength": 1 }
      }
    },
    "completeAppearance": {
      "type": "object", "additionalProperties": false,
      "required": ["asset", "assetRole", "background", "selection", "source", "appearanceSelectionReason"],
      "properties": {
        "asset": { "$ref": "#/$defs/asset" }, "assetRole": { "const": "complete-icon" },
        "background": { "$ref": "#/$defs/embeddedBackground" }, "selection": { "enum": ["native-theme-variant", "brand-color-foreground", "complete-source-artwork", "source-default", "reviewed-badge-composition"] },
        "source": { "$ref": "#/$defs/appearanceSource" }, "appearanceSelectionReason": { "type": "string", "minLength": 1 }
      }
    },
    "brand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "displayName", "issuerAliases", "selectedSource", "sources", "appearances"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "displayName": { "type": "string", "minLength": 1 },
        "issuerAliases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "selectedSource": { "$ref": "#/$defs/sourceReference" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceReference" } },
        "appearances": {
          "type": "object", "additionalProperties": false, "required": ["lightTheme", "darkTheme"],
          "properties": { "lightTheme": { "$ref": "#/$defs/appearance" }, "darkTheme": { "$ref": "#/$defs/appearance" } }
        }
      }
    }
  }
}
